{
  "name": "tomo-calendar",
  "version": "2.3.3",
  "description": "TOMO CALENDAR · 간결한 캘린더와 독립 위젯",
  "main": "dist-electron/main.js",
  "author": {
    "name": "bokmunssu"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prebuild": "yarn typecheck && vite build",
    "build": "yarn prebuild && electron-builder",
    "build:win": "yarn prebuild && electron-builder --win",
    "build:mac": "yarn prebuild && electron-builder --mac",
    "build:linux": "yarn prebuild && electron-builder --linux",
    "build:all": "concurrently \"yarn build:win\" \"yarn build:mac\"",
    "preview": "vite preview",
    "electron": "electron .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "electron:dev": "concurrently \"yarn dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "electron-builder",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "test:e2e": "playwright test",
    "build:win:portable": "yarn prebuild && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@types/react-datepicker": "^7.0.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.18",
    "electron-store": "^10.1.0",
    "electron-updater": "6.8.9",
    "korean-lunar-calendar": "0.3.6",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-datepicker": "^8.7.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.2",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "recoil": "^0.7.7",
    "rrule": "^2.8.1",
    "swiper": "^14.3.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@hyunbinseo/holidays-kr": "5.2027.2",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "1.6.1",
    "concurrently": "^8.2.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "happy-dom": "^18.0.1",
    "jsdom": "^27.0.0",
    "png-to-ico": "3.0.1",
    "sass": "^1.72.0",
    "sass-embedded": "^1.93.2",
    "sharp": "0.34.5",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "io.github.bokmunssu.tomo.calendar",
    "productName": "TOMO CALENDAR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "!**/*.{ts,map,spec.js,test.js}"
    ],
    "mac": {
      "icon": "public/tomo.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "TOMO CALENDAR 설치",
      "icon": "public/tomo.icns",
      "format": "UDZO",
      "background": null,
      "contents": [
        {
          "x": 150,
          "y": 220,
          "type": "file"
        },
        {
          "x": 450,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 600,
        "height": 400
      }
    },
    "afterPack": "scripts/verify-bundle.js",
    "win": {
      "icon": "public/tomo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TOMO CALENDAR",
      "runAfterFinish": true,
      "artifactName": "TOMO-CALENDAR-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "public/tomo.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "TOMO-CALENDAR-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "bokmunssu",
        "repo": "BOK-CALD"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bokmunssu/BOK-CALD.git"
  },
  "bugs": {
    "url": "https://github.com/bokmunssu/BOK-CALD/issues"
  },
  "homepage": "https://github.com/bokmunssu/BOK-CALD",
  "contributors": [
    {
      "name": "bokmunssu"
    }
  ],
  "resolutions": {
    "fast-uri": "^3.1.8",
    "ajv": "^8.20.0",
    "js-yaml": "^5.4.3"
  }
}
